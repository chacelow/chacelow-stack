{
  "name": "@chacelow-stack/types",
  "version": "0.2.0",
  "description": "TypeScript schemas for the Chacelow Stack project generator",
  "keywords": [
    "chacelow-stack",
    "cli",
    "schemas",
    "types",
    "typescript"
  ],
  "homepage": "https://github.com/chacelow/chacelow-stack#readme",
  "license": "MIT",
  "author": "chacelow-stack contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chacelow/chacelow-stack.git",
    "directory": "packages/types"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./schemas": {
      "types": "./dist/schemas.d.mts",
      "default": "./dist/schemas.mjs"
    },
    "./json-schema": {
      "types": "./dist/json-schema.d.mts",
      "default": "./dist/json-schema.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
